---
import Search from 'virtual:starlight/components/Search'
import logo from '../../assets/logo.svg'

const links = [
  ['Docs', '/getting-started/'],
  ['Strategies', '/strategies/timeout/'],
  ['Guides', '/guides/testing/'],
  ['Reference', '/reference/api/'],
]
---

<div class="bar">
  <div class="left">
    <a class="brand" href="/">
      <img src={logo.src} width="20" height="20" alt="" />
      <span>Tenace</span>
    </a>
    <nav aria-label="Main">
      {links.map(([text, href]) => <a href={href}>{text}</a>)}
    </nav>
  </div>

  <div class="right">
    <Search />
    <a class="icon" href="https://github.com/julien-r44/tenace" aria-label="GitHub">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="currentColor"
          d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"
        ></path>
      </svg>
    </a>
  </div>
</div>

<script>
  // Transparent over the hero, solid once the page scrolls
  const header = document.querySelector<HTMLElement>('header.header')
  if (header) {
    const update = () => header.toggleAttribute('data-scrolled', scrollY > 8)
    update()
    addEventListener('scroll', update, { passive: true })
  }
</script>

<style>
  /* Transparent over the hero, with a scrim so the links stay readable on the image */
  :global(header.header) {
    border-bottom-color: transparent;
    background: linear-gradient(to bottom, rgb(7 8 10 / 0.85), rgb(7 8 10 / 0));
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    transition:
      background-color 200ms ease-out,
      border-color 200ms ease-out;
  }
  :global(header.header[data-scrolled]) {
    border-bottom-color: var(--tn-hairline);
    background: rgb(7 8 10 / 0.75);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 68rem;
    height: 100%;
    margin-inline: auto;
  }

  .left,
  .right {
    display: flex;
    align-items: center;
  }
  .left {
    gap: 0.75rem;
    min-width: 0;
  }
  .right {
    gap: 0.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 0.125rem;
    margin-left: 1rem;
  }
  nav a {
    padding: 0.35rem 0.6rem;
    border-radius: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--sl-color-gray-1);
    text-decoration: none;
    transition:
      color 150ms ease-out,
      background-color 150ms ease-out;
  }
  nav a:hover {
    background: rgb(255 255 255 / 0.05);
    color: var(--sl-color-white);
  }

  /* Starlight's search button, compacted */
  .right :global(site-search) {
    margin-right: 0.5rem;
  }
  .right :global(button[data-open-modal]) {
    width: 13rem;
    max-width: none;
    height: 2rem;
    padding-inline: 0.6rem 0.4rem;
    border: 1px solid var(--tn-hairline);
    border-radius: 0.4375rem;
    border-color: var(--tn-hairline-strong);
    background: rgb(7 8 10 / 0.7);
    backdrop-filter: blur(6px);
    color: var(--sl-color-gray-1);
    font-size: 0.8125rem;
  }
  .right :global(button[data-open-modal] kbd) {
    font-size: 0.625rem;
  }

  .icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.375rem;
    color: var(--sl-color-gray-1);
    transition:
      color 150ms ease-out,
      background-color 150ms ease-out;
  }
  .icon:hover {
    background: rgb(255 255 255 / 0.05);
    color: var(--sl-color-white);
  }
  .icon svg {
    width: 1rem;
    height: 1rem;
  }

  @media (max-width: 50rem) {
    nav {
      display: none;
    }
    .right :global(button[data-open-modal]) {
      width: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(header.header) {
      transition: none;
    }
  }
</style>
