---
import { Code } from '@astrojs/starlight/components'
import Shape from './Shape.astro'
import * as snippets from './snippets'

const cards = [
  {
    label: 'Failure',
    title: 'Stack strategies in the order they run.',
    text: 'Each call wraps the steps added before it. The timeout bounds one attempt, the retry repeats it, the breaker stops calling a dead service, and the fallback answers.',
    href: '/concepts/strategy-order/',
    code: snippets.failure,
    shape: { kind: 'rings' as const },
    wide: true,
  },
  {
    label: 'Concurrency',
    title: 'Control how many calls run, and how often.',
    text: 'Bulkheads cap parallel work, rate limits cap throughput per key, Tenace.map runs batches with a limit.',
    href: '/strategies/bulkhead/',
    code: snippets.concurrency,
    shape: { src: '/bento/concurrency.jpg' },
  },
  {
    label: 'Typed errors',
    title: 'The compiler knows every error.',
    text: 'Your functions return Result.err(), strategies add their errors. Result.match() needs one handler for each of them.',
    href: '/concepts/typed-errors/',
    code: snippets.typed,
    shape: { src: '/bento/typed.jpg' },
  },
  {
    label: 'Chaos',
    title: 'Break it before production does.',
    text: 'Inject latency, throws, or typed errors into a share of calls, in one policy or all of them.',
    href: '/strategies/chaos/',
    code: snippets.chaos,
    shape: { kind: 'grid' as const },
  },
  {
    label: 'Testing',
    title: 'Test retries without waiting.',
    text: 'TestClock moves time only when the test says so. Three timeouts and two delays run instantly.',
    href: '/guides/testing/',
    code: snippets.testing,
    shape: { src: '/bento/testing.jpg' },
  },
]
---

<section class="bento">
  <div class="head not-content">
    <p class="label">What it does</p>
    <h2>Five jobs, one chain.</h2>
  </div>
  <div class="grid">
    {
      cards.map(card => (
        <article class:list={['card', { wide: card.wide }]}>
          <div class="plate" aria-hidden="true">
            <Shape {...card.shape} />
          </div>
          <div class="card-text not-content">
            <p class="chip">{card.label}</p>
            <h3>{card.title}</h3>
            <p class="body">{card.text}</p>
            <a href={card.href}>
              Read more <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="code">
            <Code code={card.code} lang="ts" />
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .bento {
    padding-block: 4.5rem;
    border-bottom: 1px solid var(--tn-hairline);
  }
  .head {
    margin-bottom: 2rem;
  }
  .label {
    margin: 0 0 0.75rem;
    font-family: var(--__sl-font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tn-accent);
  }
  h2 {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: -0.025em;
    color: var(--sl-color-white);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .card {
    --ec-codeFontSize: 0.75rem;
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--tn-hairline);
    border-radius: 0.875rem;
    background: var(--tn-surface);
  }
  /* Dithered shape at the top of each card, the text starts where it fades out */
  .plate {
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    aspect-ratio: 2.9;
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }
  .plate :global(.shape) {
    opacity: 0.8;
  }
  .card-text {
    padding: 7rem 1.5rem 0;
  }
  .code {
    margin-top: auto;
    padding: 1.25rem 1.5rem 1.5rem;
  }
  .card > :global(*) {
    min-width: 0;
  }
  .card :global(.expressive-code) {
    margin: 0;
  }

  .card.wide {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    align-items: stretch;
  }
  /* The wide card keeps its shape in the text column, behind the title */
  .wide .plate {
    inset: 0 auto 0 0;
    width: 45%;
    height: auto;
    aspect-ratio: auto;
    mask-image:
      linear-gradient(to right, #000 20%, transparent), linear-gradient(to bottom, #000 15%, transparent 70%);
    mask-composite: intersect;
  }
  .wide .card-text {
    align-self: end;
    padding: 6rem 1.75rem 1.75rem;
  }
  .wide .code {
    align-self: center;
    padding: 1.75rem 1.75rem 1.75rem 0;
  }

  .chip {
    display: inline-block;
    margin: 0 0 0.875rem;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--tn-hairline-strong);
    border-radius: 999px;
    background: rgb(7 8 10 / 0.7);
    backdrop-filter: blur(6px);
    font-family: var(--__sl-font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-white);
  }
  h3 {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.3;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
  }
  .wide h3 {
    font-size: 1.375rem;
  }
  .body {
    margin: 0.5rem 0 0.875rem;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }
  .card-text a {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--sl-color-white);
    text-decoration: none;
  }
  .card-text a span {
    display: inline-block;
    transition: transform 150ms ease-out;
  }
  .card-text a:hover span {
    transform: translateX(2px);
  }

  @media (max-width: 60rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .card.wide {
      display: flex;
    }
    .wide .plate {
      inset: 0 0 auto;
      width: auto;
      aspect-ratio: 1.8;
      mask-image: linear-gradient(to bottom, #000 55%, transparent);
    }
    .wide .card-text {
      padding: 9rem 1.5rem 0;
    }
    /* Centered items would size to their content and overflow the column */
    .wide .card-text,
    .wide .code {
      align-self: stretch;
    }
    .wide .code {
      padding: 1.25rem 1.5rem 1.5rem;
    }
  }
</style>
