---
import logo from '../../assets/logo.svg'

const socials = [
  {
    label: 'GitHub',
    href: 'https://github.com/julien-r44/tenace',
    icon: 'M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z',
  },
  {
    label: 'X (Twitter)',
    href: 'https://x.com/julien_rpt',
    icon: 'M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.67l7.73-8.84L1.25 2.25h6.83l4.71 6.23Zm-1.16 17.52h1.83L7.08 4.13H5.12Z',
  },
]
---

<footer class="footer not-content">
  <a class="brand" href="/">
    <img src={logo.src} width="20" height="20" alt="" />
    <span>Tenace</span>
  </a>

  <p class="credit">
    Built by <a href="https://github.com/julien-r44">Julien Ripouteau</a>. MIT licensed.
  </p>

  <div class="links">
    <a class="sponsor" href="https://github.com/sponsors/julien-r44">
      Sponsor
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19.5 12.572L12 20l-7.5-7.428A5 5 0 1 1 12 6.006a5 5 0 1 1 7.5 6.572"></path>
      </svg>
    </a>
    {
      socials.map(social => (
        <a class="social" href={social.href} aria-label={social.label} title={social.label}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path fill="currentColor" d={social.icon} />
          </svg>
        </a>
      ))
    }
  </div>
</footer>

<style>
  .footer {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    padding-block: 2rem 2.5rem;
    border-top: 1px solid var(--tn-hairline);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  a {
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease;
  }
  a:hover {
    color: var(--sl-color-white);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    justify-self: start;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--sl-color-white);
  }

  .credit {
    margin: 0;
    text-align: center;
  }
  .credit a {
    color: var(--sl-color-gray-2);
    text-decoration: underline;
    text-decoration-color: var(--tn-hairline-strong);
    text-underline-offset: 0.2em;
  }
  .credit a:hover {
    color: var(--sl-color-white);
  }

  .links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    justify-self: end;
  }
  .sponsor {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-inline-end: 0.5rem;
  }
  .sponsor svg {
    width: 0.95rem;
    height: 0.95rem;
  }
  .social {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.4rem;
  }
  .social:hover {
    background: rgb(255 255 255 / 0.06);
  }
  .social svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  @media (max-width: 50rem) {
    .footer {
      grid-template-columns: 1fr auto;
    }
    .credit {
      grid-column: 1 / -1;
      grid-row: 2;
      text-align: start;
    }
  }
</style>
