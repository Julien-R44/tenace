---
import logo from '../../assets/logo.svg'
---

<footer class="footer not-content">
  <a class="brand" href="/">
    <img src={logo.src} width="20" height="20" alt="" />
    <span>Tenace</span>
  </a>

  <p class="credit">
    Built by <a href="https://github.com/julien-r44">Julien Ripouteau</a>. MIT licensed.
  </p>

  <div class="links">
    <a class="sponsor" href="https://github.com/sponsors/julien-r44">
      Sponsor
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19.5 12.572L12 20l-7.5-7.428A5 5 0 1 1 12 6.006a5 5 0 1 1 7.5 6.572"></path>
      </svg>
    </a>
  </div>
</footer>

<style>
  .footer {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1rem 1.25rem;
    border-top: 1px solid var(--tn-hairline);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-1);
  }

  a {
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease;
  }
  a:hover {
    color: var(--sl-color-white);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    justify-self: start;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--sl-color-white);
  }

  .credit {
    margin: 0;
    text-align: center;
  }
  .credit a {
    color: var(--sl-color-white);
    text-decoration: underline;
    text-decoration-color: var(--tn-hairline-strong);
    text-underline-offset: 0.2em;
  }
  .credit a:hover {
    color: var(--sl-color-white);
  }

  .links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    justify-self: end;
  }
  .sponsor {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .sponsor svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  @media (max-width: 50rem) {
    .footer {
      grid-template-columns: 1fr auto;
    }
    .credit {
      grid-column: 1 / -1;
      grid-row: 2;
      text-align: start;
    }
  }
</style>
