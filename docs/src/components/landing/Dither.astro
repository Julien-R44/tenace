---
// Ordered dithering of the hero image, cropped like object-fit: cover around a focus point
interface Props {
  focusX?: number
  focusY?: number
  class?: string
}

const { focusX = 0.5, focusY = 0.5, class: className } = Astro.props
---

<canvas
  class:list={['dither', className]}
  data-src="/hero-source.jpg"
  data-focus-x={focusX}
  data-focus-y={focusY}
  aria-hidden="true"></canvas>

<script>
  const BAYER = [
    0, 32, 8, 40, 2, 34, 10, 42, 48, 16, 56, 24, 50, 18, 58, 26, 12, 44, 4, 36, 14, 46, 6, 38, 60, 28,
    52, 20, 62, 30, 54, 22, 3, 35, 11, 43, 1, 33, 9, 41, 51, 19, 59, 27, 49, 17, 57, 25, 15, 47, 7, 39,
    13, 45, 5, 37, 63, 31, 55, 23, 61, 29, 53, 21,
  ].map(value => (value + 0.5) * 4)

  function paint(canvas: HTMLCanvasElement, image: HTMLImageElement) {
    const width = canvas.clientWidth
    const height = canvas.clientHeight
    if (width === 0 || height === 0) return
    canvas.width = width
    canvas.height = height
    const context = canvas.getContext('2d', { willReadFrequently: true })
    if (!context) return

    const focusX = Number(canvas.dataset['focusX'] ?? 0.5)
    const focusY = Number(canvas.dataset['focusY'] ?? 0.5)
    const scale = Math.max(width / image.naturalWidth, height / image.naturalHeight)
    const drawWidth = image.naturalWidth * scale
    const drawHeight = image.naturalHeight * scale
    context.drawImage(
      image,
      (width - drawWidth) * focusX,
      (height - drawHeight) * focusY,
      drawWidth,
      drawHeight,
    )
    const pixels = context.getImageData(0, 0, width, height)

    const tint = context.createRadialGradient(
      width * 0.7,
      height * 0.2,
      0,
      width * 0.7,
      height * 0.2,
      Math.max(width, height) * 0.8,
    )
    const styles = getComputedStyle(canvas)
    tint.addColorStop(0, '#f4f4f5')
    tint.addColorStop(0.55, styles.getPropertyValue('--tn-accent').trim() || '#8b8cff')
    tint.addColorStop(1, styles.getPropertyValue('--tn-accent-2').trim() || '#6ee7f9')
    context.fillStyle = tint
    context.fillRect(0, 0, width, height)
    const colors = context.getImageData(0, 0, width, height).data

    const data = pixels.data
    for (let y = 0; y < height; y++) {
      const row = (y & 7) * 8
      for (let x = 0; x < width; x++) {
        const index = (y * width + x) * 4
        const on = data[index]! > BAYER[row + (x & 7)]!
        data[index] = colors[index]!
        data[index + 1] = colors[index + 1]!
        data[index + 2] = colors[index + 2]!
        data[index + 3] = on ? 255 : 0
      }
    }
    context.putImageData(pixels, 0, 0)
  }

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('canvas.dither')) {
    const image = new Image()
    image.src = canvas.dataset['src'] ?? ''
    void image.decode().then(() => {
      let lastWidth = 0
      let frame = 0
      new ResizeObserver(() => {
        if (canvas.clientWidth === lastWidth) return
        lastWidth = canvas.clientWidth
        cancelAnimationFrame(frame)
        frame = requestAnimationFrame(() => paint(canvas, image))
      }).observe(canvas)
    })
  }
</script>

<style>
  .dither {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }
</style>
